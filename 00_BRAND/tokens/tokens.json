{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens da Primeira Igreja Batista em Águas Claras. Esta é a ÚNICA fonte da verdade da marca: o CSS, o SCSS e o preset do Tailwind são gerados daqui por _META/automacao/gerar-tokens.py. Nunca escreva um hex à mão no código. \"$value\": null significa decisão de design ainda não tomada — enquanto houver null, o script se recusa a gerar.",

  "cor": {
    "marca": {
      "primaria":   { "$type": "color", "$value": null, "$description": "A cor que carrega a marca. Onde a pessoa bate o olho e reconhece a igreja" },
      "secundaria": { "$type": "color", "$value": null, "$description": "Acompanha a primária sem competir com ela" },
      "apoio":      { "$type": "color", "$value": null, "$description": "Destaque pontual — botão, selo, detalhe. Nunca área grande" }
    },
    "profunda": {
      "primaria":   { "$type": "color", "$value": null, "$description": "Versão escura da primária, para onde a clara não sustenta texto" }
    },
    "neutra": {
      "clara":  { "$type": "color", "$value": null, "$description": "Fundo de respiro, quase branco" },
      "media":  { "$type": "color", "$value": null, "$description": "Divisórias, bordas, estados desativados" },
      "escura": { "$type": "color", "$value": null, "$description": "A cor mais escura do sistema. Costuma ser a base do texto" }
    },
    "texto": {
      "padrao":    { "$type": "color", "$value": null, "$description": "Corpo de texto. Pode referenciar outra: \"{cor.neutra.escura}\"" },
      "suave":     { "$type": "color", "$value": null, "$description": "Legenda, crédito, dado secundário" },
      "invertido": { "$type": "color", "$value": null, "$description": "Texto sobre fundo escuro" }
    },
    "fundo": {
      "claro":  { "$type": "color", "$value": null },
      "escuro": { "$type": "color", "$value": null }
    }
  },

  "fonte": {
    "familia": {
      "display": { "$type": "fontFamily", "$value": null, "$description": "Títulos e chamadas. Inclua os fallbacks: \"'Nome', Georgia, serif\"" },
      "texto":   { "$type": "fontFamily", "$value": null, "$description": "Corpo, legenda, interface" }
    },
    "peso": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medio":    { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "tamanho": {
      "xs":  { "$type": "dimension", "$value": "0.75rem" },
      "sm":  { "$type": "dimension", "$value": "0.875rem" },
      "md":  { "$type": "dimension", "$value": "1rem" },
      "lg":  { "$type": "dimension", "$value": "1.25rem" },
      "xl":  { "$type": "dimension", "$value": "1.563rem" },
      "2xl": { "$type": "dimension", "$value": "1.953rem" },
      "3xl": { "$type": "dimension", "$value": "2.441rem" },
      "4xl": { "$type": "dimension", "$value": "3.052rem" },
      "5xl": { "$type": "dimension", "$value": "3.815rem" }
    },
    "entrelinha": {
      "apertada": { "$type": "number", "$value": 1.1 },
      "media":    { "$type": "number", "$value": 1.35 },
      "solta":    { "$type": "number", "$value": 1.6 }
    },
    "tracking": {
      "apertado": { "$type": "dimension", "$value": "-0.02em" },
      "normal":   { "$type": "dimension", "$value": "0" },
      "largo":    { "$type": "dimension", "$value": "0.18em" }
    }
  },

  "espaco": {
    "1":  { "$type": "dimension", "$value": "0.25rem" },
    "2":  { "$type": "dimension", "$value": "0.5rem" },
    "3":  { "$type": "dimension", "$value": "0.75rem" },
    "4":  { "$type": "dimension", "$value": "1rem" },
    "6":  { "$type": "dimension", "$value": "1.5rem" },
    "8":  { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },

  "raio": {
    "sm":     { "$type": "dimension", "$value": "0.5rem" },
    "md":     { "$type": "dimension", "$value": "1rem" },
    "lg":     { "$type": "dimension", "$value": "1.5rem" },
    "xl":     { "$type": "dimension", "$value": "2rem" },
    "pilula": { "$type": "dimension", "$value": "999px" }
  },

  "sombra": {
    "suave": { "$type": "shadow", "$value": null, "$description": "Depende da cor escura da marca. Ex.: \"0 2px 12px rgba(R, G, B, 0.08)\"" },
    "media": { "$type": "shadow", "$value": null }
  }
}
