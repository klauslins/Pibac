  "naming_convention": {
    "pattern": "[type]-[slug]-[variant]-v[N].[ext]",
    "rules": [
      "Apenas minúsculas",
      "Sem acentos ou caracteres especiais",
      "Separador: hífen (-)",
      "Nunca usar 'final', 'final2', 'FINAL_REAL' — use versões numeradas"
    ],
    "valid_types": [
      "post",
      "story",
      "reels",
      "banner",
      "logo",
      "roteiro",
      "copy",
      "outdoor",
      "card",
      "thumbnail",
      "carrossel"
    ],
    "valid_variants": [
      "colorido",
      "dark",
      "branco",
      "preto",
      "horizontal",
      "vertical",
      "h",
      "v"
    ]
  },
  "asset_statuses": [
    "draft",
    "review",
    "approved",
    "published",
    "archived"
  ],
